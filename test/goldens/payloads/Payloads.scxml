<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:hfsm="https://github.com/finger563/webgme-hfsm" version="1.0" name="Payloads" initial="S_2f_p_2f_m_2f_Idle">
  <state id="S_2f_p_2f_m_2f_Idle" hfsm:name="Idle" hfsm:timer-period="0.1">
    <onentry><script>printf(&quot;IDLE ENTRY\n&quot;);</script></onentry>
    <onexit><script>printf(&quot;IDLE EXIT\n&quot;);</script></onexit>
    <transition event="BUTTON_PRESS" cond="pressCount &lt; 1">
      <script>pressCount++; printf(&quot;PRESS %d id=%d long=%d\n&quot;, pressCount, data.button_id, (int)data.long_press);</script>
    </transition>
    <transition event="BUTTON_PRESS" target="S_2f_p_2f_m_2f_Running">
      <script>printf(&quot;GO id=%d\n&quot;, data.button_id);</script>
    </transition>
  </state>
  <state id="S_2f_p_2f_m_2f_Running" hfsm:name="Running" hfsm:timer-period="0.1">
    <onentry><script>printf(&quot;RUNNING ENTRY speed=%.1f\n&quot;, speed);</script></onentry>
    <onexit><script>printf(&quot;RUNNING EXIT\n&quot;);</script></onexit>
    <transition event="SET_SPEED">
      <script>speed = data.speed; printf(&quot;SPEED %.1f\n&quot;, speed);</script>
    </transition>
    <transition event="STOP" target="S_2f_p_2f_m_2f_Idle"/>
    <transition event="FINISH" target="S_2f_p_2f_m_2f_end"/>
  </state>
  <final id="S_2f_p_2f_m_2f_end"/>
</scxml>
