{
  "root": "/p",
  "objects": {
    "/p": {
      "name": "FixtureProject",
      "type": "Project"
    },
    "/p/m": {
      "name": "Basic",
      "type": "State Machine",
      "Includes": "#include <cstdio>",
      "Declarations": "int startCount = 0;",
      "Initialization": "startCount = 0;"
    },
    "/p/m/i": {
      "name": "Initial",
      "type": "Initial"
    },
    "/p/m/ti": {
      "name": "InitialTransition",
      "type": "External Transition",
      "pointers": {
        "src": "/p/m/i",
        "dst": "/p/m/Idle"
      }
    },
    "/p/m/Idle": {
      "name": "Idle",
      "type": "State",
      "Timer Period": 0.1,
      "Entry": "printf(\"IDLE ENTRY\\n\");",
      "Exit": "printf(\"IDLE EXIT\\n\");"
    },
    "/p/m/Active": {
      "name": "Active",
      "type": "State",
      "Timer Period": 0.1,
      "Entry": "printf(\"ACTIVE ENTRY %d\\n\", _root->startCount);",
      "Tick": "printf(\"ACTIVE TICK\\n\");"
    },
    "/p/m/end": {
      "name": "End",
      "type": "End State"
    },
    "/p/m/tStart": {
      "name": "startTransition",
      "type": "External Transition",
      "Event": "START",
      "Action": "_root->startCount++;",
      "pointers": {
        "src": "/p/m/Idle",
        "dst": "/p/m/Active"
      }
    },
    "/p/m/tStop": {
      "name": "stopTransition",
      "type": "External Transition",
      "Event": "STOP",
      "pointers": {
        "src": "/p/m/Active",
        "dst": "/p/m/Idle"
      }
    },
    "/p/m/tEnd": {
      "name": "endTransition",
      "type": "External Transition",
      "Event": "ENDEVENT",
      "pointers": {
        "src": "/p/m/Active",
        "dst": "/p/m/end"
      }
    }
  }
}
